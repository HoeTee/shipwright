+def _restore_parameter_source(
+    ctx: Context, name: str, previous: ParameterSource | None
+) -> None:
+    """Drop a provisional parameter source written for conversion.
+
+    ``previous`` is ``None`` when the slot had no source yet. The key is
+    removed in that case so :meth:`Context.get_parameter_source` returns
+    ``None`` again instead of keeping the value that failed or lost.
+    """
+    if previous is None:
+        ctx._parameter_source.pop(name, None)
+    else:
+        ctx.set_parameter_source(name, previous)
+
+
