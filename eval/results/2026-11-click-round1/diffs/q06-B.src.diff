+def _replace_parameter_source(
+    ctx: Context, name: str, source: ParameterSource | None
+) -> ParameterSource | None:
+    """Store ``source`` for ``name`` and return the source that was there before.
+
+    ``None`` clears the recorded source. Conversion and callbacks need the
+    origin of the value they are handling, but a feature-switch sibling may
+    still own the slot afterwards.
+    """
+    previous = ctx.get_parameter_source(name)
+    if source is None:
+        ctx._parameter_source.pop(name, None)
+    else:
+        ctx.set_parameter_source(name, source)
+    return previous
+
