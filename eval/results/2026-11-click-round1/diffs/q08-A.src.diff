+def _mask_hidden_prompt_error(message: str, value: t.Any) -> str:
+    """Return an error for a failed hidden prompt without revealing the secret.
+
+    Built-in types include the value via ``{value!r}``. That quoted form is
+    replaced with ``'***'``. If the raw value is still present, the message
+    is replaced with a generic error.
+    """
+    secret = value if isinstance(value, str) else str(value)
+    masked = message.replace(repr(secret), "'***'")
+    if secret and secret in masked:
+        return _("The value you entered was invalid.")
+    return masked
+
