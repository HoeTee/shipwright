+# Stems whose trailing period belongs to the abbreviation ("vs.", "Dr."),
+# not to the end of a sentence. Compared case-insensitively.
+_ABBREVIATION_STEMS = {
+    "cf",
+    "dr",
+    "eg",
+    "ie",
+    "jr",
+    "mr",
+    "mrs",
+    "ms",
+    "prof",
+    "sr",
+    "st",
+    "vs",
+}
+
+# "e.g.", "i.e.", "U.S.", "U.S.A.", "Ph.D.", "a.m." — at least one internal
+# period, and every dot-separated piece is a short alpha token.
+_DOTTED_ABBREVIATION_RE = re.compile(r"[A-Za-z]{1,2}(?:\.[A-Za-z]{1,2})+\.")
+
+
+def _period_ends_sentence(word: str, next_word: str | None) -> bool:
+    """Return whether ``word``'s trailing period ends a sentence.
+
+    A period that is part of an abbreviation (``vs.``, ``e.g.``, ``Dr.``)
+    is not a boundary. A following lowercase word is a continuation
+    (``9. aaaa``), not a new sentence. A capital letter or a digit
+    (``fruit. 3``) starts one.
+    """
+    if not word.endswith("."):
+        return False
+
+    if (
+        _DOTTED_ABBREVIATION_RE.fullmatch(word)
+        or word[:-1].lower() in _ABBREVIATION_STEMS
+    ):
+        return False
+
+    if next_word is None:
+        return True
+
+    return not next_word[0].islower()
+
