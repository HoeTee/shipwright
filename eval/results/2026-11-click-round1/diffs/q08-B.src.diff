+def _format_hidden_prompt_error(value: t.Any, message: str) -> str | None:
+    """Return a validation error that does not reveal a hidden entry.
+
+    Built-in types quote the value with :func:`repr`. That form is replaced
+    with ``'***'`` so the rest of the message can still be shown. If the raw
+    value remains anywhere in the text, the message is not safe to display
+    and ``None`` is returned so the caller can use a generic error.
+    """
+    secret = value if isinstance(value, str) else str(value)
+    rendered = message.replace(repr(value), repr("***"))
+
+    if secret and secret in rendered:
+        return None
+
+    return rendered
+
+
